<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Profil FastDDS pour Ubuntu NATIF (utilise a la place de fastdds.xml hors WSL).

  Difference avec fastdds.xml : la memoire partagee est ACTIVEE. Hors WSL,
  AWSIM (sur l'hote) et le conteneur Autoware partagent /dev/shm (ipc: host
  dans docker/awsim.compose.yaml) : les gros messages, nuages de points en
  tete, sont transmis sans copie reseau ni fragmentation UDP. Mesure sur un
  portable 6 coeurs : avec UDP seul, charge ~95 et diagnostics Autoware
  "STALE", ce qui bloque le passage en mode autonome.

  L'UDP reste disponible (decouverte, et repli si la memoire partagee echoue).
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>shm_large</transport_id>
                <type>SHM</type>
                <segment_size>33554432</segment_size>
                <maxMessageSize>33554432</maxMessageSize>
            </transport_descriptor>
            <transport_descriptor>
                <transport_id>udp_large_buffers</transport_id>
                <type>UDPv4</type>
                <sendBufferSize>16777216</sendBufferSize>
                <receiveBufferSize>16777216</receiveBufferSize>
                <maxMessageSize>65000</maxMessageSize>
                <maxInitialPeersRange>10</maxInitialPeersRange>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="awsim_autoware_native" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>shm_large</transport_id>
                    <transport_id>udp_large_buffers</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
